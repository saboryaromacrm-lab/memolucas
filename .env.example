# Copiá este archivo como .env y completá los valores. Nunca lo subas al repo.

NODE_ENV=production
PORT=3100
HOST=127.0.0.1

# Conexión a PostgreSQL (base y usuario creados para la app)
DATABASE_URL=postgresql://memolucas:una-clave-segura@127.0.0.1:5432/memolucas

# Clave de la API de Claude (console.anthropic.com → API Keys). Se puede reemplazar desde el panel.
ANTHROPIC_API_KEY=

# Clave larga y aleatoria: firma la sesión del panel y cifra la API key cargada desde el panel.
# Generala con: openssl rand -base64 48
APP_SECRET=

TZ=America/Argentina/Buenos_Aires

# Carpeta persistente: sesión de WhatsApp (auth/) y fotos (media/). Fuera del proyecto.
DATA_DIR=/var/www/memolucas-data
